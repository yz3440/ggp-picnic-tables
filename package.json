{
  "name": "ggp-picnic-tables",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,vite -c blue,green \"bun run server/index.ts\" \"vite\"",
    "dev:server": "bun run server/index.ts",
    "dev:client": "vite",
    "build": "vite build && cp -r model dist/model",
    "preview": "vite preview"
  },
  "dependencies": {
    "@loaders.gl/core": "^4.3.4",
    "@loaders.gl/gltf": "^4.3.4",
    "@luma.gl/core": "^9.2.6",
    "@luma.gl/webgl": "^9.2.6",
    "@mantine/core": "^8.3.15",
    "@mantine/hooks": "^8.3.15",
    "deck.gl": "^9.2.9",
    "hono": "^4.12.2",
    "mapbox-gl": "^3.18.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "bun-types": "^1.3.9",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
